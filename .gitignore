# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# data files — local only
/data/*.csv
/data/**/*.xlsx
/data/**/*.xls
*.zip

__pycache__/
*.pyc

# secrets (added by security audit)
.env.production
.env.local
.env*.local
cf-secrets.json
.dev.vars
.dev.vars*

# local wrangler/miniflare state (never commit)
.wrangler/
uat-report/artifacts/
uat-report/index.html
uat-results/
