#         default: '10'
#
# concurrency:
#   # Two runs must never overlap (a schedule tick colliding with a manual dispatch, or
#   # a long run overrunning into the next day). Writers are idempotent, but a paid
#   # extraction racing a second run wastes money. Do NOT cancel-in-progress: let the
#   # first run finish; the second queues.
#   group: aacapital-daily-pipeline
#   cancel-in-progress: false
