{
  "name": "aacapital-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "prod:market": "python _scripts/prod/kite_sync_and_predict.py --mode market",
    "prod:ipo": "python _scripts/prod/kite_sync_and_predict.py --mode ipo",
    "prod:all": "python _scripts/prod/kite_sync_and_predict.py --mode all",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "uat:all": "npm run typecheck && npm run build && python -m pytest _scripts/tests/ -q && playwright test --project=desktop --project=tablet --project=mobile",
    "uat:smoke": "node uat/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"lib/**/*.test.ts\"",
    "set-password": "node _scripts/set-password.mjs",
    "worker:kite:dry-run": "wrangler deploy --config workers/kite-broker-proxy/wrangler.jsonc --dry-run",
    "worker:kite:types": "wrangler types --config workers/kite-broker-proxy/wrangler.jsonc workers/kite-broker-proxy/worker-configuration.d.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@opennextjs/cloudflare": "^1.20.1",
    "@vercel/postgres": "^0.10.0",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "commander": "^15.0.0",
    "csv-parse": "^6.2.1",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-auth": "^5.0.0-beta.31",
    "nse-bse-api": "^0.1.3",
    "p-limit": "^7.3.0",
    "pg": "^8.21.0",
    "pg-cloudflare": "^1.4.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "swr": "^2.4.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "wrangler": "^4.110.0"
  },
  "overrides": {
    "adm-zip": "^0.6.0"
  }
}
