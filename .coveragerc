# Coverage config — the CORE denominator (roadmap Phase 2: define core
# explicitly so the 90 pct target is meaningful). Core = the nightly IPO
# pipeline steps + health gates + route-contract scripts. Multibagger
# engines, backtests, archive, one-off fixes are out BY DECISION.
[run]
parallel = true
sigterm = true
include =
    */_scripts/ipo_score.py
    */_scripts/compute_verdicts.py
    */_scripts/compute_flags.py
    */_scripts/parse_sbi_notes.py
    */_scripts/check_value_sanity.py
    */_scripts/check_dupes.py
    */_scripts/check_data_contract.py
    */_scripts/sync_issue_details.py
    */_scripts/schema_sync.py
    */_scripts/rhp_sonnet.py
    */_scripts/build_ipo_consolidated_v2.py
    */_scripts/fetch_peer_pe.py
    */_scripts/compute_quality_score.py
    */_scripts/run_ipo_pipeline_lean.py

[report]
skip_empty = true
precision = 1
